<?xml version="1.0" encoding="utf-8" ?>
<Project>
	<Target Name="PackPlugin" AfterTargets="AfterBuild;Publish">
		<MakeDir Directories="$(PluginPublishDir)"/>

		<Pack PluginAssembly="$(AssemblyName)"
			  PluginVersion="$(Version)"
			  PluginId="$(PluginId)"
			  PluginName="$(Title)"
			  PluginAuthors="$(Authors)"
			  PluginDescription="$(Description)"
			  ProjectUrl="$(ProjectUrl)"
			  PluginApiVersion="$(PluginApiVersion)"
			  PluginSide="$(PluginSide)"
			  PluginDependencies="@(PluginDependency)"
			  PluginPublishDir="$(PluginPublishDir)"
			  PluginMetadataFile="$(PluginMetadataFile)"
			  PluginAssetsDir="$(PluginAssetsDir)"
			  PluginDataDir="$(PluginDataDir)"
			  PluginSigningKey="$(PluginSigningKey)" />
	</Target>
</Project>
